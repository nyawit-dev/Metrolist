# Maintainer: nyawit-dev
pkgname=nyawit-music-git
pkgver=14.0.0
pkgrel=1
pkgdesc='YouTube Music desktop client'
arch=('x86_64')
url='https://github.com/nyawit-dev/nyawit-music'
license=('GPL-3.0-only')
depends=('alsa-lib' 'dbus' 'fontconfig' 'gtk3' 'hicolor-icon-theme' 'libglvnd' 'libsecret' 'libxi' 'libxrender' 'libxtst' 'webkit2gtk-4.1')
makedepends=('git' 'jdk21-openjdk' 'jdk25-temurin')
provides=('nyawit-music')
conflicts=('nyawit-music')
options=('!strip' '!debug')
_project_dir="$startdir/.."
if [[ -f "$_project_dir/settings.gradle.kts" && -x "$_project_dir/gradlew" ]]; then
  source=('nyawit-music.desktop')
  sha256sums=('27367952ff5babca9c2c211aad3918d87370fbb8a7607e65cd1d433b18945586')
else
  source=("nyawit-music::git+https://github.com/nyawit-dev/nyawit-music.git#branch=main"
          'nyawit-music.desktop')
  sha256sums=('27367952ff5babca9c2c211aad3918d87370fbb8a7607e65cd1d433b18945586'
              '27367952ff5babca9c2c211aad3918d87370fbb8a7607e65cd1d433b18945586')
fi

_source_dir() {
  if [[ -f "$_project_dir/settings.gradle.kts" && -x "$_project_dir/gradlew" ]]; then
    printf '%s\n' "$_project_dir"
  else
    printf '%s\n' "$srcdir/nyawit-music"
  fi
}

pkgver() {
  cd "$(_source_dir)"
  printf '%s.r%s.g%s' "$(sed -n 's/^appVersion=//p' gradle.properties)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  if [[ ! -f "$_project_dir/settings.gradle.kts" || ! -x "$_project_dir/gradlew" ]]; then
    cd "$(_source_dir)"
    git submodule update --init --recursive
  fi
}

build() {
  cd "$(_source_dir)"
  "${GRADLE:-./gradlew}" --no-daemon :desktopApp:createReleaseDistributable
}

package() {
  cd "$(_source_dir)"
  local appdir='desktopApp/build/compose/binaries/main-release/app/NyawitMusic'
  install -d "$pkgdir/opt/nyawit-music" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" "$pkgdir/usr/share/icons/hicolor/512x512/apps"
  cp -a "$appdir/." "$pkgdir/opt/nyawit-music/"
  ln -s /opt/nyawit-music/bin/NyawitMusic "$pkgdir/usr/bin/nyawit-music"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktopApp/src/desktopMain/resources/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/nyawit-music.png"
  install -Dm644 "$srcdir/nyawit-music.desktop" "$pkgdir/usr/share/applications/NyawitMusic.desktop"
}
